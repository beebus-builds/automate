# ─────────────────────────────────────────────────────────────
# TeacherFolio environment variables (copy to `.env` and fill in)
# ─────────────────────────────────────────────────────────────

# Database
# Local default: SQLite at data/teacher.db (no env needed).
# For PostgreSQL (e.g. Neon) — set both:
# USE_POSTGRES=true
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Secrets — required in prod (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ENCRYPTION_KEY=64 hex chars (AES-256-GCM for vercel_token at rest)
# CSRF_SECRET=64 hex chars (HMAC for double-submit CSRF)
# Example:
# ENCRYPTION_KEY=e2e234d629435b302fb8ef11eb0b91db2810ad1029b3df45290fe88ac77cd298
# CSRF_SECRET=2ad0114e2781739abceb94e531777b0b6a80e0e8c269a5f1bec5d38c4492fa7c

# App URL for SEO/sitemap
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Vercel deployment token (optional — used by "Deploy" on the build page).
# Create one at https://vercel.com/account/tokens
# VERCEL_TOKEN=

# Ollama — optional. Powers chat field extraction on the build page.
# Unset (or not running) simply falls back to the regex parser in lib/conversation.ts.
# Install + run: https://ollama.com/download
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3:8b