# ─────────────────────────────────────────────────────────────
# TeacherFolio environment variables (copy to `.env` and fill in)
# ─────────────────────────────────────────────────────────────

# Database
# Local default: SQLite at data/teacher.db (no env needed).
# For PostgreSQL (e.g. Neon) — set both:
# USE_POSTGRES=true
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Vercel deployment token (optional — used by "Deploy" on the build page).
# Create one at https://vercel.com/account/tokens
# VERCEL_TOKEN=

# WebRTC signaling server (the Python FastAPI server)
# Shared secret the app issues to authenticated teachers. MUST be set for
# calls to work. Generate one, e.g. with:  openssl rand -hex 32
# SIGNALING_TEACHER_TOKEN=

# Comma-separated browser origins allowed to connect to the signaling server.
SIGNALING_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# The WebSocket URL the generated sites + CMS use to reach the signaling server.
NEXT_PUBLIC_SIGNALING_URL=ws://127.0.0.1:8765/ws/signal

# Local RAG configuration (Ollama) — optional, used by the chat assistant.
# Ollama must be running: https://ollama.com/download
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3:8b